# OpenCode
OPENCODE_MODEL="opencode-go/deepseek-v4.1-flash"
OPENCODE_AGENT="issue-runner"
MIN_OPENCODE_VERSION="2.0.23"

# Repository. Leave blank to auto-detect from `gh repo view`.
GITHUB_REPO=""

# Queue labels
READY_LABEL="ready-for-agent"
RUNNING_LABEL="agent-running"
DONE_LABEL="agent-done"
BLOCKED_LABEL="agent-blocked"
AUTO_CREATE_LABELS=1

# Queue behavior
ISSUE_LIMIT=100
MAX_ISSUES=0
STOP_ON_BLOCKED=1
FORCE=0

# Git behavior
AUTO_COMMIT=1
COMMIT_PREFIX="issue"
ALLOWED_BRANCH=""
ROLLBACK_ON_FAILURE=1

# Safe defaults: commit locally, do not push or close GitHub Issues.
AUTO_PUSH=0
AUTO_CLOSE_ISSUE=0
AUTO_COMMENT=1

# Full automation example:
# AUTO_PUSH=1
# AUTO_CLOSE_ISSUE=1

# Closing an issue without pushing the implementation is blocked by default.
ALLOW_CLOSE_WITHOUT_PUSH=0

# Diagnostics
DRY_RUN=0
LOG_DIR=".scratch/opencode-auto-logs"
CONTEXT_DIR=".scratch/opencode-issue-context"
